# Kotlin 官方风格（docs/standards/coding-standards.md 第 1 节）：ktlint 与 detekt 共用行宽。
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# Compose 规范：@Composable 函数名用 PascalCase（docs/standards/coding-standards.md），
# 官方豁免机制而非关闭整条 function-naming 规则。
ktlint_function_naming_ignore_when_annotated_with = Composable
