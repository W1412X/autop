<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WP5 验收用假支付页（docs/tech/10 WP5），仅 debug 构建；exported 供 adb 拉起。 -->
    <application>
        <activity
            android:name=".PaymentTestActivity"
            android:exported="true"
            android:label="@string/payment_test_title" />
        <!-- shell 执行真机验证入口（shell-exec 设计 §14，仅 debug）：adb am broadcast 触发。 -->
        <receiver
            android:name=".ShellExecDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.autop.debug.SHELL_EXEC" />
                <action android:name="com.example.autop.debug.SHELL_RELEASE" />
                <action android:name="com.example.autop.debug.SHELL_CLOSE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
