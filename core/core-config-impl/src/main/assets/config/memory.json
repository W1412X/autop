{
  "schemaVersion": 7,
  "memory": {
    "path": {
      "maxSegmentChars": 64,
      "maxDepth": 8
    },
    "summary": {
      "maxChars": 60
    },
    "node": {
      "maxContentChars": 20000
    },
    "write": {
      "supplementPromptId": "memory.write.supplement"
    },
    "keywords": {
      "maxCount": 12,
      "maxChars": 20
    },
    "embedding": {
      "retryMax": 3,
      "retryBaseMs": 2000
    },
    "search": {
      "channels": ["retriever.keyword", "retriever.vector"],
      "weights": {
        "retriever.keyword": 0.6,
        "retriever.vector": 0.4
      },
      "perChannelLimit": 30,
      "defaultK": 8,
      "minCjkChars": 2,
      "minAsciiChars": 3
    },
    "vector": {
      "minScore": 0.55,
      "topN": 20
    },
    "l0": {
      "maxTokens": 1500,
      "maxChildrenPerRoot": 8
    },
    "profile": {
      "maxTokens": 300
    },
    "list": {
      "maxDepth": 3
    },
    "prefetch": {
      "k": 3,
      "maxChars": 300,
      "minKeywordScore": 2.0
    }
  }
}
