{
  "schemaVersion": 3,
  "memory": {
    "path": {
      "maxSegmentChars": 64,
      "maxDepth": 8
    },
    "summary": {
      "maxChars": 60,
      "autoGenerate": true
    },
    "node": {
      "maxContentChars": 20000
    },
    "write": {
      "supplementPromptId": "memory.write.supplement"
    },
    "embedding": {
      "chunkChars": 400,
      "retryMax": 3,
      "retryBaseMs": 2000
    },
    "search": {
      "channels": ["retriever.path", "retriever.fts", "retriever.vector"],
      "weights": {
        "retriever.path": 1.2,
        "retriever.fts": 1.0,
        "retriever.vector": 1.0
      },
      "rrfK": 60,
      "perChannelLimit": 30,
      "vectorOverfetch": 3,
      "defaultK": 8
    },
    "l0": {
      "maxTokens": 1500,
      "maxChildrenPerRoot": 8
    },
    "profile": {
      "maxTokens": 300
    },
    "list": {
      "maxDepth": 3
    },
    "triggerPrefetch": {
      "k": 3
    }
  }
}
