    },
    "image": {
      "maxEdge": 1568
    },
    "probe": {
      "timeoutMs": 30000
    },
    "embedding": {
      "provider": "none",
      "profileId": null,
      "model": null,
      "dimension": null,
      "batchSize": 16
    }
  }
