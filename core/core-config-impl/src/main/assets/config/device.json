{
  "schemaVersion": 7,
  "device": {
    "capture": {
      "timeoutMs": 1500,
      "maxNodes": 3000,
      "emptyTreeRetries": 3,
      "emptyTreeRetryDelayMs": 200
    },
    "events": {
      "buffer": 256
    },
    "stabilize": {
      "quietMs": 300,
      "maxWaitMs": 3000,
      "pollMs": 50,
      "firstEventTimeoutMs": 800
    },
    "serializer": {
      "textMaxChars": -1,
      "maxMergedLabels": 4,
      "maxListItems": -1,
      "semanticPoorMinInteractive": 3,
      "semanticPoorAreaRatio": 0.5,
      "hideSystemDecoration": true
    },
    "screenshot": {
      "maxEdge": 1024,
      "jpegQuality": 80,
      "minIntervalMs": 1000,
      "retryDelayMs": 400,
      "retries": 3,
      "vision": {
        "blockSize": 28,
        "maxBlocks": 1500,
        "maxLongEdge": 1568
      }
    },
    "observe": {
      "priority": ["a11y", "visual"],
      "modes": {
        "a11y": { "enabled": true, "auto": true },
        "visual": { "enabled": true, "auto": true }
      },
      "sufficiency": {
        "minEffectiveNodes": 5
      }
    },
    "vision": {
      "enabled": true,
      "roiRatio": 0.5,
      "minConfidence": 0.35,
      "modelPack": "basic",
      "timeoutMs": 60000,
      "icon": {
        "enabled": true
      },
      "parallel": {
        "maxThreads": 4,
        "cropOrtThreads": 1
      }
    },
    "change": {
      "positionTolerance": 12,
      "frameMaxHamming": 3,
      "frameMinSsim": 0.97
    },
    "overlay": {
      "hideSettleMs": 120
    },
    "touch": {
      "enabled": true,
      "sources": ["outside_touch", "a11y_events"],
      "selfActionGraceMs": 400,
      "selfActionMaxMs": 15000,
      "shieldEnabled": true,
      "shieldRelayoutTimeoutMs": 500
    },
    "tap": {
      "durationMs": 100,
      "longPressMs": 600,
      "jitterMaxPx": 10,
      "jitterRatio": 0.15
    },
    "scroll": {
      "stepRatio": 0.5,
      "edgeInsetRatio": 0.1,
      "pixelsPerMs": 1.5,
      "minDurationMs": 250,
      "maxDurationMs": 900,
      "maxSteps": 5,
      "swipeDurationMs": 350,
      "stepDelayMs": 300,
      "swipeMaxDurationMs": 3000,
      "endpointJitterPx": 12,
      "trajectoryJitterPx": 8
    },
    "wait": {
      "pollMs": 500,
      "defaultTimeoutMs": 10000
    },
    "notifications": {
      "ignoreOngoing": true,
      "maxMessages": 5,
      "recentBuffer": 200
    },
    "replay": {
      "maxKeys": 200
    },
    "intent": {
      "preferredMap": "auto",
      "askTimeoutMs": 60000,
      "timerMaxSeconds": 86400,
      "calendarDefaultMinutes": 60,
      "textMaxChars": 4000
    },
    "action": {
      "delayMs": 5000,
      "maxDelayMs": 30000
    },
    "input": {
      "focusDelayMs": 500,
      "clipboardRestoreDelayMs": 400
    },
    "shell": {
      "commandTimeoutMs": 5000
    },
    "apps": {
      "listLimit": 50
    }
  }
}
